# Supabase 대시보드 > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 (절대 NEXT_PUBLIC_ 접두어 금지). service_role 키 또는 sb_secret_ 키
SUPABASE_SERVICE_ROLE_KEY=

# 부모 모드 쿠키 서명용 비밀값 (32바이트 이상 랜덤). 예: openssl rand -base64 32
APP_SECRET=

# (권장) 교재 사진 단어 인식 — Gemini 무료 등급 가능 (https://aistudio.google.com/apikey)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# (선택) Gemini 키가 없을 때 Claude 사용. 둘 다 없으면 브라우저 내 Tesseract OCR
# ANTHROPIC_API_KEY=
# (선택) 발음 품질 향상 — 미설정 시 비공식 Google Translate TTS로 폴백
# GOOGLE_TTS_API_KEY=

# (선택) Cloudflare Turnstile CAPTCHA — 로그인·가입·비밀번호 재설정·탈퇴 봇 방지. 비워 두면 위젯 없이 기존 동작.
# Cloudflare 대시보드 > Turnstile 의 Site Key (공개값). Secret Key 는 Supabase 대시보드
# > Authentication > Attack Protection > CAPTCHA 에만 넣는다. 반드시 이 값을 먼저 배포한 뒤 Supabase CAPTCHA 를 켤 것.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
