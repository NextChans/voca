# Supabase 대시보드 > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 (절대 NEXT_PUBLIC_ 접두어 금지). service_role 키 또는 sb_secret_ 키
SUPABASE_SERVICE_ROLE_KEY=

# 부모 모드 쿠키 서명용 비밀값 (32바이트 이상 랜덤). 예: openssl rand -base64 32
APP_SECRET=

# (선택) 사진 단어 인식 품질 향상 — 미설정 시 브라우저 내 Tesseract OCR 사용
# ANTHROPIC_API_KEY=
# (선택) 발음 품질 향상 — 미설정 시 비공식 Google Translate TTS로 폴백
# GOOGLE_TTS_API_KEY=
